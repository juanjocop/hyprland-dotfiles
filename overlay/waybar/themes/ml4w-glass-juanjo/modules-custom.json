{
    // Temperatura CPU — script propio en vez del módulo `temperature` nativo.
    // El nativo obliga a fijar hwmon-path-abs, y esa ruta es justo lo que cambia entre equipos
    // (Intel coretemp ↔ AMD k10temp). El script resuelve el sensor por NOMBRE de hwmon, que
    // además es estable entre arranques (hwmonN no lo es). Umbral crítico: 85 °C.
    "custom/cputemp": {
        "exec": "~/.config/waybar/themes/ml4w-glass-juanjo/scripts/cputemp.sh",
        "return-type": "json",
        "interval": 5,
        "format": "{}",
        "tooltip": true,
        "on-click": "~/.config/ml4w/settings/system-monitor.sh"
    },
    // Temperatura GPU NVIDIA — script condicional: solo consulta nvidia-smi si la GPU ya está
    // despierta (runtime_status=active); si duerme (portátil Optimus), NO la despertamos.
    // La dirección PCI y el nombre de la tarjeta los resuelve el script, así que el tooltip
    // dice la GPU real de cada equipo (por eso ya no hay "tooltip-format" fijo aquí).
    "custom/gputemp": {
        "exec": "~/.config/waybar/themes/ml4w-glass-juanjo/scripts/gputemp.sh",
        "return-type": "json",
        "interval": 5,
        "format": "{}",
        "tooltip": true,
        "on-click": "~/.config/ml4w/settings/system-monitor.sh"
    },
    // Fondo de vídeo (mpvpaper) — UN botón por pantalla, independientes: cada uno enciende su
    // propio mpvpaper en su monitor y se apaga sin tocar el otro. No arrancan con el sistema.
    // El argumento final es la "ranura": 1 = monitor principal (LIVE_WALLPAPER_MONITOR de
    // local.env, o el primero por id), 2 = el otro monitor conectado. Con una sola pantalla el
    // script devuelve texto vacío para la ranura 2 y waybar oculta el botón.
    // Los dos comparten la señal 8, así que un clic en cualquiera refresca ambos.
    "custom/livewallpaper": {
        "exec": "~/.config/waybar/themes/ml4w-glass-juanjo/scripts/livewallpaper.sh status 1",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "format": "{}",
        "tooltip": true,
        "on-click": "~/.config/waybar/themes/ml4w-glass-juanjo/scripts/livewallpaper.sh toggle 1"
    },
    "custom/livewallpaper2": {
        "exec": "~/.config/waybar/themes/ml4w-glass-juanjo/scripts/livewallpaper.sh status 2",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "format": "{}",
        "tooltip": true,
        "on-click": "~/.config/waybar/themes/ml4w-glass-juanjo/scripts/livewallpaper.sh toggle 2"
    },
    // Luz nocturna (hyprsunset) — override manual sobre el horario de hyprsunset.conf.
    // Clic: alterna cálido/neutro. Clic derecho: devuelve el mando al horario.
    // interval (no "once"): el horario cambia solo a las 07:00/21:00 sin avisar a waybar,
    // así que hay que sondear; la señal solo cubre nuestras propias pulsaciones.
    "custom/nightlight": {
        "exec": "~/.config/waybar/themes/ml4w-glass-juanjo/scripts/nightlight.sh status",
        "return-type": "json",
        "interval": 30,
        "signal": 9,
        "format": "{}",
        "tooltip": true,
        "on-click": "~/.config/waybar/themes/ml4w-glass-juanjo/scripts/nightlight.sh toggle",
        "on-click-right": "~/.config/waybar/themes/ml4w-glass-juanjo/scripts/nightlight.sh schedule"
    },
    // ── Control de inactividad ────────────────────────────────────────────────────────────────
    // Grupo desplegable: un icono visible (ancla) y, al pasar el ratón, tres interruptores para
    // desactivar por separado el bloqueo, el apagado de pantallas y la suspensión. Sirve para
    // dejar algo trabajando solo sin que el equipo se suspenda (una suspensión CONGELA los
    // procesos; bloquear o apagar pantallas no detiene nada).
    //
    // El script vive en ~/.config/ml4w-juanjo/ y NO aquí dentro, porque hypridle.conf también
    // depende de él: no debe romperse si algún día se cambia de theme de waybar.
    //
    // ⚠ El botón `custom/hypridle` que ML4W mete en `group/tools` hace lo mismo a lo bruto
    // (killall hypridle) y NO debe usarse: se lleva por delante el after_sleep_cmd que arregla la
    // pantalla en negro al reanudar. No se puede quitar sin editar el modules.json compartido de
    // ML4W, cosa que este overlay no hace.
    "group/inactividad": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "children-class": "inactividad-hijo",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/inactividad",
            "custom/idle-pantallas",
            "custom/idle-bloqueo",
            "custom/idle-suspension"
        ]
    },
    // Ancla del grupo: resume el estado (nada / algo / todo desactivado) y con un clic alterna
    // los tres a la vez ("modo trabajo en curso"). Mismo glifo en los tres estados, solo cambia
    // el color: si cambiase el icono bailaría el ancho de la barra.
    "custom/inactividad": {
        "exec": "~/.config/ml4w-juanjo/scripts/idle-guard.sh estado maestro",
        "return-type": "json",
        "interval": "once",
        "signal": 10,
        "format": "{}",
        "tooltip": true,
        "on-click": "~/.config/ml4w-juanjo/scripts/idle-guard.sh alternar maestro"
    },
    // Los tres interruptores. interval "once" (no sondeo, como livewallpaper): el estado solo
    // cambia con nuestros clics. La señal 10 la comparten los cuatro módulos, así que al pulsar
    // cualquiera se refrescan también el ancla y sus hermanos.
    "custom/idle-pantallas": {
        "exec": "~/.config/ml4w-juanjo/scripts/idle-guard.sh estado pantallas",
        "return-type": "json",
        "interval": "once",
        "signal": 10,
        "format": "{}",
        "tooltip": true,
        "on-click": "~/.config/ml4w-juanjo/scripts/idle-guard.sh alternar pantallas"
    },
    "custom/idle-bloqueo": {
        "exec": "~/.config/ml4w-juanjo/scripts/idle-guard.sh estado bloqueo",
        "return-type": "json",
        "interval": "once",
        "signal": 10,
        "format": "{}",
        "tooltip": true,
        "on-click": "~/.config/ml4w-juanjo/scripts/idle-guard.sh alternar bloqueo"
    },
    "custom/idle-suspension": {
        "exec": "~/.config/ml4w-juanjo/scripts/idle-guard.sh estado suspension",
        "return-type": "json",
        "interval": "once",
        "signal": 10,
        "format": "{}",
        "tooltip": true,
        "on-click": "~/.config/ml4w-juanjo/scripts/idle-guard.sh alternar suspension"
    }
}
